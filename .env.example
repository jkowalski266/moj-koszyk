# Poniższe wartości publiczne konfigurują połączenie frontendu z Supabase.
# Skopiuj ten plik jako .env i uzupełnij wartości wyłącznie lokalnie.

# Supabase — wartości publiczne używane przez frontend.
# Dostęp do danych musi być ograniczony przez Row Level Security (RLS).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
