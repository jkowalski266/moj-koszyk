# Obecna wersja aplikacji nie korzysta jeszcze ze zmiennych środowiskowych.
# Poniższe nazwy są szablonem dla planowanych integracji.
# Skopiuj ten plik jako .env i uzupełnij wartości wyłącznie lokalnie.

# Supabase — wartości publiczne używane przez frontend.
# Dostęp do danych musi być ograniczony przez Row Level Security (RLS).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Zewnętrzne API / LLM
# Ten klucz może być odczytywany wyłącznie przez kod serwerowy.
# Nie używaj prefiksu VITE_, ponieważ ujawniłoby to wartość w przeglądarce.
OPENAI_API_KEY=replace-with-server-side-key
